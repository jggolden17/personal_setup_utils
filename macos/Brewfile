# ─────────────────────────────────────────────────────────────── 
# ─── Terminal ───
# ───────────────────────────────────────────────────────────────

# ─── core terminal ───
# Terminal multiplexer
brew "tmux"
# Terminal emulator, nicer than macOS Terminal.app
cask "iterm2"

# ─── replacements for std tools ───
# Smarter `cd` - jumps to frequently/recently used directories by partial name
brew "zoxide"
# Fast, user-friendly `find` replacement
brew "fd"
# Fuzzy finder - powers Ctrl-R history search, file search, and many vim/tmux plugins
brew "fzf"
# Fast grep replacement, used internally by fzf and many editor plugins
brew "ripgrep"
# `cat` with syntax highlighting and git integration
brew "bat"
# Modern `ls` replacement - icons, git status, tree view
brew "eza"
# Interactive process/resource viewer (nicer htop)
brew "btop"

# ─── look and feel ───
# Cross-shell prompt showing git branch, venv, exit status, etc.
brew "starship"

# ─── db ───
# Object-relational database system
brew "postgresql@18"
# run a local mongodb 
tap "mongodb/brew"
brew "mongodb-community"

# ─── git ─── 
# Quickly rewrite git repository history
brew "git-filter-repo"
# Git extension for versioning large files
brew "git-lfs"
# Much more readable git diffs (side-by-side, syntax highlighted)
brew "git-delta"
# Terminal UI for git - stage, commit, branch, rebase visually
brew "lazygit"

# ─── utils ───
# Auto-loads/unloads env vars when you cd into a directory - good for per-project secrets/config
brew "direnv"
# Lightweight and flexible command-line JSON processor
brew "jq"
# Same as jq but for YAML
brew "yq"
# 1Password CLI - pull secrets into shell/scripts without hardcoding them
cask "1password-cli"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# Command-line client for WebSockets
brew "websocat"
# Cryptography and SSL/TLS Toolkit
brew "openssl@3"
# Play, record, convert, and stream select audio and video codecs
brew "ffmpeg"
# Tools and libraries to manipulate images in select formats
brew "imagemagick"

# ─── zsh ───
# Fish-like fast/unobtrusive autosuggestions for zsh
brew "zsh-autosuggestions"
# Additional completion definitions for zsh
brew "zsh-completions"
# Fish shell like syntax highlighting for zsh
brew "zsh-syntax-highlighting"

# ─── bash ───
# A newer bash than the one macOS ships, made the default login shell
brew "bash"
# Tab-completion for bash commands and flags
brew "bash-completion@2"
# Lint/static-analysis for shell scripts
brew "shellcheck"

