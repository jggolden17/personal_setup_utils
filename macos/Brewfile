# ───────────────────────────────────────────────────────────────
# ─── nodejs ───
# ───────────────────────────────────────────────────────────────

# Node itself comes from nvm (curl-installed by setup.sh), not brew: nvm's
# README says brew installs are unsupported. Global npm packages live in
# configs/npm-globals.txt and are installed by setup.sh after nvm runs,
# since `brew bundle` would try to run these npm lines before node exists.

# ─────────────────────────────────────────────────────────────── 
# ─── VS Code extensions ───
# ───────────────────────────────────────────────────────────────
# ─── ai assistants ───
vscode "anthropic.claude-code"
#   Official Anthropic extension that brings Claude Code (an agentic AI coder) into VS Code.
#   Lets Claude read/edit your code, run terminal commands, show inline diffs, and review plans before applying.

# ─── python tooling (core) + linting + formatting + type checking) ───
vscode "ms-python.python"
#   Official Python extension: language support, interpreter management, debugging, testing, Jupyter integration.
vscode "ms-python.vscode-pylance"
#   Fast Python language server (from Microsoft) for IntelliSense, type inference, go-to-definition, etc.
vscode "ms-python.vscode-python-envs"
#   Helps manage Python environments (venv, conda, etc.) and switch interpreters more easily.
vscode "ms-python.debugpy"
#   Debugger backend used by the Python extension for running and stepping through Python code.

# ─── python tooling (linting + formatting + type checking) ───
vscode "charliermarsh.ruff"
#   Integration for Ruff: extremely fast Python linter + formatter that can replace Flake8, isort, Black, pyupgrade, etc.
# vscode "ms-python.black-formatter"
#   Runs Black (Python formatter) inside VS Code.
#   Redundant if you use Ruff as your formatter
# vscode "ms-python.flake8"
#   Runs Flake8 (Python linter) inside VS Code.
#   Redundant if you use Ruff as your linter
# vscode "ms-python.pylint"
#   Runs Pylint (another Python linter) inside VS Code.
#   Usually redundant with Ruff or Flake8
vscode "ms-python.mypy-type-checker"
#   Runs mypy (static type checker) inside VS Code.
vscode "njpwerner.autodocstring"
#   Automatically generates Python docstring templates when you type triple quotes after a function/method.

# ─── javascript / typescript / web tooling ───
vscode "dbaeumer.vscode-eslint"
#   ESLint integration for JavaScript/TypeScript: linting, quick fixes, format-on-save integration.
#   Keep if your JS/TS projects use ESLint; otherwise optional.

vscode "esbenp.prettier-vscode"
#   Prettier formatter for JS/TS, JSON, CSS, etc. Formats code on save or on demand.
#   Very common; keep if your projects use Prettier.

vscode "stylelint.vscode-stylelint"
#   Stylelint integration for CSS/SCSS/etc.: linting styles with rules and auto-fixes.
#   Keep if your project uses Stylelint; otherwise optional.

vscode "bradlc.vscode-tailwindcss"
#   Tailwind CSS IntelliSense: autocomplete, class-name validation, hover previews, etc.
#   Keep if you use Tailwind CSS; otherwise remove.

vscode "svelte.svelte-vscode"
#   Language support for Svelte: syntax highlighting, IntelliSense, linting, formatting.
#   Keep only if you develop in Svelte.

vscode "prisma.prisma"
#   Language support for Prisma schema files (database ORM for Node/TS).
#   Keep only if you use Prisma in your projects.

# ─── markdown / docs / diagrams ───
vscode "bierner.markdown-mermaid"
#   Renders Mermaid diagrams inside Markdown preview (flowcharts, sequence diagrams, etc.).
#   Keep if you write Markdown with Mermaid diagrams; otherwise optional.

# ─── sql formatting ───
vscode "inferrinizzard.prettier-sql-vscode"
#   Prettier-based SQL formatter: formats SQL files on save or on demand.
#   Keep if you edit SQL files and want auto-formatting; otherwise optional.

# ─── azure / containers / docker / bicep ───
vscode "docker.docker"
#   Official Docker extension 

# ─── git / repo tooling ───
vscode "eamodio.gitlens"
#   Advanced Git integration: blame annotations, history, compare branches, rich commit insights.

# ─── jupyter / notebooks ───
vscode "ms-toolsai.jupyter"
#   Core Jupyter support: run notebooks, interactive windows, variable explorer, plots.

vscode "ms-toolsai.jupyter-keymap"
#   Adds Jupyter-style keyboard shortcuts to VS Code notebooks.

# vscode "ms-toolsai.jupyter-renderers"
#   Extra renderers for notebook outputs (e.g., vegalite, plotly, etc.).

vscode "vscodevim.vim"
#   Vim keybindings inside VS Code.
vscode "editorconfig.editorconfig"
#   Applies .editorconfig file settings (indent size, line endings, etc.) per project.