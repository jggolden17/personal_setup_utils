[user]
	name = Jack Golden
	email = 147710675+jggolden17@users.noreply.github.com
[init]
	defaultBranch = main
[pull]
	ff = only
[push]
	default = current
	autoSetupRemote = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictstyle = diff3
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
